
import random
import math

def fitness(x):
    return (x - 2)**2 + math.sin(5 * x)

# Parameters
population_size = 20
generations = 100
gene_length = 12
mutation_rate = 0.05

# Generate binary chromosomes
population = [
    [random.randint(0, 1) for _ in range(gene_length)]
    for _ in range(population_size)
]

# Gene expression: binary to real value
def express(gene):
    value = int("".join(map(str, gene)), 2)
    return -5 + (value / (2**gene_length - 1)) * 10

for gen in range(generations):

    # Evaluate population
    population.sort(
        key=lambda gene: fitness(express(gene))
    )

    # Preserve best chromosome
    new_population = [population[0][:]]

    while len(new_population) < population_size:

        # Selection
        p1 = random.choice(population[:10])
        p2 = random.choice(population[:10])

        # Crossover
        point = random.randint(1, gene_length - 1)

        child = p1[:point] + p2[point:]

        # Mutation
        for i in range(gene_length):
            if random.random() < mutation_rate:
                child[i] = 1 - child[i]

        new_population.append(child)

    population = new_population

# Best chromosome
best_gene = min(
    population,
    key=lambda gene: fitness(express(gene))
)

best_solution = express(best_gene)

print("Best Chromosome:", best_gene)
print("Best Solution:", best_solution)
print("Minimum Fitness:", fitness(best_solution))
